{
  "name": "testmeman-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite apps/web --config apps/web/vite.config.ts",
    "build": "tsc -b apps/web/tsconfig.app.json && vite build apps/web --config apps/web/vite.config.ts",
    "typecheck": "tsc -b apps/web/tsconfig.app.json && tsc -p apps/api/tsconfig.server.json",
    "preview": "vite preview apps/web --config apps/web/vite.config.ts",
    "server": "tsx watch apps/api/server/src/index.ts",
    "server:start": "tsx apps/api/server/src/index.ts",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "test": "tsx --test packages/shared/tests/*.test.ts services/question-engine/tests/*.test.ts services/execution-engine/tests/*.test.ts apps/api/tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "mongodb": "^6.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2"
  }
}
